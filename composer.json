{
    "name": "gatovel/framework",
    "description": "The Gatovel PHP Framework — a modular and extensible framework for building modern web applications.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "nucleo\\": "src/nucleo/",
            "app\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"require 'vendor/autoload.php'; (new \\app\\Installer())->run();\""
        ]
    }
}