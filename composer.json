        "gatovel/cli": "^1.0.5",
        "gatovel/database": "^1.0",
        "gatovel/auth": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "nucleo\\": "src/nucleo/",
            "app\\": "src/app/"
        }
    }
